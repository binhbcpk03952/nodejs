# ===================================================
# NÚI XANH BADMINTON - ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================
# Ghi chú: Sao chép file này thành .env và điền các giá trị thực tế.
# Không commit file .env chứa mật khẩu thật lên hệ thống quản lý mã nguồn.

# ---------------------------------------------------
# FRONTEND CONFIGURATION (Vite - Các biến bắt đầu bằng VITE_)
# ---------------------------------------------------
# Prefix API URL cho Axios (trong môi trường dev proxy sẽ rewrite /api -> backend)
VITE_API_URL=/api

# Địa chỉ Server Backend phục vụ static uploads/assets
VITE_SERVER_URL=http://localhost:3030

# ---------------------------------------------------
# BACKEND CONFIGURATION (Server Express)
# ---------------------------------------------------
# Cổng chạy của backend server
PORT=3030

# Môi trường chạy: development | production | test
NODE_ENV=development

# Cấu hình kết nối MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=badminton_shop

# Giới hạn connection pool (khuyến nghị 10)
DB_CONNECTION_LIMIT=10

# Khóa bí mật ký JWT Token (thay đổi bằng một chuỗi ngẫu nhiên dài trong production)
JWT_SECRET=nui_xanh_badminton_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Cấu hình CORS (cho phép frontend truy cập, có thể phân tách bằng dấu phẩy)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
